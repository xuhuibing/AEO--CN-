# ====================================================================
# AEO海关认证管理系统 — 环境变量配置
# 复制此文件为 .env 并修改配置:
#   cp .env.example .env
# ====================================================================

# ── 服务端口 ─────────────────────────────────────────────
PORT=3080

# ── 管理员 Basic Auth 凭据 ───────────────────────────────
# 注意: 这些是 Basic Auth 凭据，用于 API 兼容和后台管理
# 前端 Session 登录使用 admin/admin123 (可在管理界面修改)
ADMIN_USERNAME=aeo
ADMIN_PASSWORD=aeo2026

# ── API 密钥（用于系统间集成） ──────────────────────────
# 留空则不启用。设置后可通过 X-API-Key 头或 ?api_key= 参数认证
API_KEY=

# ── 飞书开放平台集成（可选） ────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 运行环境 ─────────────────────────────────────────────
NODE_ENV=production
